RewriteEngine On

# Si es archivo o carpeta real, no tocar
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Ruta raíz del proyecto → inicio
RewriteRule ^$ index.php?route=inicio [L,QSA]

# Rutas limpias
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?route=$1 [L,QSA]
